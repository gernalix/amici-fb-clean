[Unit]
Description=Telegram alert after amici_fb repeated failure
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/amici_fb
Environment=TELEGRAM_NOTIFY_CONFIG=%h/.config/codex/secrets/telegram.env
EnvironmentFile=-%h/.config/codex/secrets/telegram.env
ExecStart=/usr/bin/python3 %h/projects/amici_fb/scripts/alert_failure.py
TimeoutStartSec=45s
NoNewPrivileges=true
PrivateTmp=true
