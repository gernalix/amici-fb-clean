# Last verified: 2026-06-25
# amici_fb local environment example.
# Copy to .env, fill only the values you need, and never commit the real .env.

# Telegram notifications now use a reusable system/user library. Store real
# values in ~/.config/codex/secrets/telegram.env with mode 600, not in
# this repository.
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
TELEGRAM_CHAT_ID=replace_with_telegram_chat_id

# Uptime Kuma Push monitor URL for this amici_fb monitor.
# Quote the URL because the value copied from Kuma usually contains &.
UPTIME_KUMA_PUSH_URL="https://kuma.example.invalid/api/push/REPLACE_WITH_MONITOR_TOKEN?status=up&msg=OK&ping="
UPTIME_KUMA_CONNECT_TIMEOUT_SECONDS=2
UPTIME_KUMA_MAX_TIME_SECONDS=5

# Optional: set to 1 to also send a STARTED heartbeat at run start.
AMICI_FB_KUMA_PUSH_STARTED=0

# Optional diagnostics and overrides.
AMICI_FB_DB=
AMICI_FB_IMPORT_TRACE=0
AMICI_FB_STACK_DUMP_SECONDS=0
AMICI_FB_STORAGE_STATE=
AMICI_FB_CHROMIUM_PROFILE=
AMICI_FB_CHROMIUM_EXECUTABLE=/usr/bin/chromium-browser
PYTHONUNBUFFERED=1
